# Copy to .env.local for local development, and set the same name in Vercel -> Settings -> Environment Variables.

# Base URL of the deployed backend (Render), no trailing slash.
NEXT_PUBLIC_API_URL=https://your-service.onrender.com

# Backend only (listed here for reference - the frontend never reads it):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
